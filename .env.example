# Get your free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: Firecrawl (https://www.firecrawl.dev, 1,000 free credits/month).
# Unlocks Cloudflare-protected aggregator sites and verifies Cloudflare-blocked links.
FIRECRAWL_API_KEY=

# Optional: Gemini model for search and image identification (default: gemini-2.5-flash).
# Must support Google Search grounding. Newer models may need billing enabled on your key.
GEMINI_MODEL=

# Optional: SauceNAO (https://saucenao.com, free account: 100 image searches a day, 4 per 30 seconds).
# Improves image search for scanned manga pages (often gives the chapter). Without it, Gemini vision is used.
SAUCENAO_API_KEY=

# Only needed when the frontend is hosted separately (e.g. GitHub Pages):
# sites allowed to call this server, comma-separated, e.g. https://inward17.github.io
ALLOWED_ORIGINS=
# Number of proxies in front of the server (1 on Render/Fly), so rate limits see real visitor IPs.
TRUST_PROXY=
