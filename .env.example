# Get your free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: Firecrawl (https://www.firecrawl.dev, 1,000 free credits/month).
# Unlocks Cloudflare-protected aggregator sites and verifies Cloudflare-blocked links.
FIRECRAWL_API_KEY=

# Optional: Gemini model for search and image identification (default: gemini-2.5-flash).
# Must support Google Search grounding. Newer models may need billing enabled on your key.
GEMINI_MODEL=
